{
  "manifest_version": 3,
  "name": "ProMeter ChatGPT Companion",
  "version": "1.0.0",
  "key": "",
  "description": "Runs approved same-origin ChatGPT fetches for ProMeter from a normal browser session. Does not read cookie databases or send tokens.",
  "permissions": ["nativeMessaging", "storage", "scripting", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ProMeter",
    "default_popup": "popup.html"
  }
}

<Window x:Class="CycleArc.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to CycleArc"
        Width="520"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}"
        ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Welcome to CycleArc" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" Text="Windows tray monitor that reconstructs ChatGPT Pro usage from account conversation history."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="Step1Title" Text="1. Review before enabling sync" FontSize="15"/>
                <TextBlock x:Name="Step1Body" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="CycleArc uses unofficial ChatGPT web endpoints. These are not part of the public OpenAI API and may change without notice. Programmatic history access is unsupported and may conflict with applicable ChatGPT terms. Review current terms before enabling synchronization. Official ChatGPT Data Export import is the lower-risk fallback but is not real-time. Only a matching server quota counter is authoritative; reconstructed history counts are estimates. The browser companion avoids embedded OAuth; it does not make this integration official."/>
                <TextBlock x:Name="Step2Title" Text="2. Choose how to connect" FontSize="15"/>
                <ComboBox x:Name="TransportBox" Margin="0,8,0,8" SelectedIndex="0" SelectionChanged="OnTransportChanged">
                    <ComboBoxItem Content="Browser companion (recommended for Chrome/Edge social login)"/>
                    <ComboBoxItem Content="WebView2 fallback (only if sign-in works there)"/>
                    <ComboBoxItem Content="Data Export import only (not real-time)"/>
                </ComboBox>
                <TextBlock x:Name="SocialHint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Google, Microsoft, and Apple sign-in are not supported inside WebView2. Use the browser companion with your normal browser session. CycleArc never spoofs a user agent."/>
                <StackPanel x:Name="CompanionPanel">
                    <TextBlock x:Name="CompanionHint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Load the unpacked extension, enter its ID, register the native host, then Connect in the popup. Finish can be used after registration without running a sync."/>
                    <Button x:Name="OpenExtensionButton" Style="{StaticResource GhostButton}" Content="Open extension folder" Click="OnOpenExtension" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ChromeIdLabel" Foreground="{DynamicResource MutedBrush}" Text="Chrome extension ID (32 letters a-p)" Margin="0,0,0,4"/>
                    <TextBox x:Name="ChromeExtensionIdBox" Margin="0,0,0,6"/>
                    <TextBlock x:Name="EdgeIdLabel" Foreground="{DynamicResource MutedBrush}" Text="Edge extension ID if different" Margin="0,0,0,4"/>
                    <TextBox x:Name="EdgeExtensionIdBox" Margin="0,0,0,6"/>
                    <Button x:Name="RegisterCompanionButton" Style="{StaticResource GhostButton}" Content="Register selected native host" Click="OnRegisterCompanion" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <TextBlock x:Name="CompanionStateText" Foreground="{DynamicResource MutedBrush}" Text="Not installed" Margin="0,0,0,8"/>
                    <Button x:Name="OpenChatGptButton" Style="{StaticResource GhostButton}" Content="Open chatgpt.com in your browser" Click="OnOpenChatGpt" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                </StackPanel>
                <TextBlock x:Name="Step3Title" Text="3. Choose your Pro plan" FontSize="15"/>
                <ComboBox x:Name="PlanBox" Margin="0,8,0,12" SelectedIndex="0">
                    <ComboBoxItem Content="Pro $100 (50 shared weekly)"/>
                    <ComboBoxItem Content="Pro $200 (200 weekly + daily Sol Pro)"/>
                    <ComboBoxItem Content="Custom (edit later in Settings)"/>
                </ComboBox>
                <TextBlock x:Name="Step4Title" Text="4. Optional background behavior" FontSize="15"/>
                <TextBlock x:Name="OptInHint" Text="Both options stay off unless you check them."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <CheckBox x:Name="StartupBox" Content="Start with Windows" Foreground="{DynamicResource TextBrush}" Margin="0,2" IsChecked="False"/>
                <CheckBox x:Name="AutoSyncBox" Content="Automatic history synchronization" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,12" IsChecked="False"/>
                <TextBlock x:Name="Step5Title" Text="5. Sign in, then run a first manual sync" FontSize="15"/>
                <TextBlock x:Name="ProgressText" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                           Text="Sign-in alone does not scan history. After you are signed in, use Run first manual sync."
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2">
            <DockPanel>
                <Button x:Name="FinishButton" Style="{StaticResource GhostButton}" Content="Finish" Click="OnFinish" HorizontalAlignment="Left" IsEnabled="False"/>
                <Button x:Name="SyncButton" Style="{StaticResource GhostButton}" Content="Run first manual sync" Click="OnSync" HorizontalAlignment="Right" IsEnabled="False"/>
            </DockPanel>
            <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" Content="Sign in / connect" Click="OnSignIn" HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="CycleArc.UI.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CycleArc.UI"
        xmlns:text="clr-namespace:CycleArc.Services;assembly=CycleArc.Core"
        Title="{x:Static text:UiText.WidgetTitle}" Style="{StaticResource AppWindow}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        PreviewMouseLeftButtonDown="OnPreviewLeftDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewLeftUp"
        LostMouseCapture="OnLostMouseCapture" MouseDown="OnMouseDown">
    <Border Background="{DynamicResource CardBrush}"
            CornerRadius="10"
            Padding="10,8"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            MinWidth="168">
        <!-- The native window can be taller than DesiredSize; center within its actual height. -->
        <StackPanel x:Name="WidgetStatusStack" VerticalAlignment="Center">
            <TextBlock x:Name="ProductTitle" Text="{x:Static text:UiText.ProductName}" FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}"/>
            <DockPanel Margin="0,0,0,8">
                <ui:UsageProviderBadge x:Name="ProviderBadge" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                <TextBlock x:Name="AccountName" Visibility="Collapsed" MaxWidth="180" TextTrimming="CharacterEllipsis"
                           FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
            </DockPanel>
            <DockPanel>
                <TextBlock x:Name="CodexValue"
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12"/>
                <TextBlock x:Name="CodexLabel"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12"/>
            </DockPanel>
            <TextBlock x:Name="HistoryValue"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11"
                       Margin="0,6,0,0"/>
            <TextBlock x:Name="ClaudeReceipt" Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</Window>

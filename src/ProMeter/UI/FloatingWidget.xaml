<Window x:Class="ProMeter.UI.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProMeter widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="OnDrag">
    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="10,6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <TextBlock x:Name="Label" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13"/>
    </Border>
</Window>

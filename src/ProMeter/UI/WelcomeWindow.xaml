<Window x:Class="ProMeter.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to ProMeter"
        Width="500"
        Height="620"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}"
        ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Welcome to ProMeter" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Windows tray monitor that reconstructs ChatGPT Pro usage from account conversation history."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="1. Review before enabling sync" FontSize="15"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="ProMeter uses unofficial ChatGPT web endpoints. These are not part of the public OpenAI API and may change without notice. Programmatic history access is unsupported and may conflict with applicable ChatGPT terms. Review current terms before enabling synchronization. Official ChatGPT Data Export import is the lower-risk fallback but is not real-time. Only a matching server quota counter is authoritative; reconstructed history counts are estimates."/>
                <TextBlock Text="2. Sign in to ChatGPT" FontSize="15"/>
                <TextBlock Text="ProMeter uses a private WebView2 session. Browser cookies are never extracted."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <TextBlock Text="3. Choose your Pro plan" FontSize="15"/>
                <ComboBox x:Name="PlanBox" Margin="0,8,0,12" SelectedIndex="0">
                    <ComboBoxItem Content="Pro $100 (50 shared weekly)"/>
                    <ComboBoxItem Content="Pro $200 (200 weekly + daily Sol Pro)"/>
                    <ComboBoxItem Content="Custom (edit later in Settings)"/>
                </ComboBox>
                <TextBlock Text="4. Optional background behavior" FontSize="15"/>
                <TextBlock Text="Both options stay off unless you check them."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <CheckBox x:Name="StartupBox" Content="Start with Windows" Foreground="{StaticResource TextBrush}" Margin="0,2" IsChecked="False"/>
                <CheckBox x:Name="AutoSyncBox" Content="Automatic history synchronization" Foreground="{StaticResource TextBrush}" Margin="0,6,0,12" IsChecked="False"/>
                <TextBlock Text="5. Manual first sync after sign-in" FontSize="15"/>
                <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                           Text="After you sign in, ProMeter can run one manual scan of the current quota period. Auto-sync does not start unless you opt in."
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2">
            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Content="Sign in to ChatGPT"
                    Click="OnPrimaryClick" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>

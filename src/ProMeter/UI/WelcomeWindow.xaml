<Window x:Class="ProMeter.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to ProMeter"
        Width="460"
        Height="420"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}"
        ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Welcome to ProMeter" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Windows tray monitor for ChatGPT Pro quota and model usage."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="1. Sign in to ChatGPT" FontSize="15"/>
            <TextBlock Text="ProMeter uses a private WebView2 session. Browser cookies are never extracted."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>
            <TextBlock Text="2. Choose your Pro plan" FontSize="15"/>
            <ComboBox x:Name="PlanBox" Margin="0,8,0,16" SelectedIndex="0">
                <ComboBoxItem Content="Pro $100 (50 shared weekly)"/>
                <ComboBoxItem Content="Pro $200 (200 weekly + daily Sol Pro)"/>
                <ComboBoxItem Content="Custom (edit later in Settings)"/>
            </ComboBox>
            <TextBlock Text="3. Sync current usage" FontSize="15"/>
            <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                       Text="Usage is reconstructed from your ChatGPT conversation history, including other PCs and mobile."
                       TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel Grid.Row="2">
            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Content="Sign in to ChatGPT"
                    Click="OnPrimaryClick" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>

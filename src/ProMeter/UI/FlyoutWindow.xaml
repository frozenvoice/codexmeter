<Window x:Class="ProMeter.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProMeter"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FlyoutValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
        <StackPanel>
            <DockPanel>
                <TextBlock Text="ProMeter" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </DockPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="GPT PRO"/>
            <DockPanel>
                <TextBlock x:Name="ProCountText" DockPanel.Dock="Right" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                <Border Height="8" CornerRadius="4" Background="#2A3140" Margin="0,4,12,0">
                    <Border x:Name="ProBar" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource AccentBrush}"/>
                </Border>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Remaining" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="RemainingText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}"/>
            </DockPanel>
            <TextBlock x:Name="CountSourceText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
            <StackPanel x:Name="Pro200Panel" Visibility="Collapsed" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock Text="GPT-6 Pro week" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="Gpt6WeekText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Sol Pro daily" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="SolDailyText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Combined daily" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="CombinedDailyText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
                </DockPanel>
            </StackPanel>
            <ItemsControl x:Name="ModelRows" Margin="0,8,0,0"/>

            <TextBlock Style="{StaticResource SectionTitle}" Text="SOL REASONING"/>
            <DockPanel><TextBlock Text="Today" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ReasonToday" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock Text="This week" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ReasonWeek" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock Text="Medium" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ReasonMedium" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock Text="High" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ReasonHigh" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock Text="Extra High" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ReasonExtra" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock Text="Limit" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ReasonLimit" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="STATUS"/>
            <DockPanel><TextBlock Text="Reset" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ResetText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock Text="Last sync" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SyncText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <Button Click="OnCoverageClick" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand" Margin="0,4,0,0">
                <DockPanel>
                    <TextBlock Text="Coverage" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="CoverageText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                </DockPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>

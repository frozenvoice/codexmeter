<Window x:Class="ProMeter.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexMeter"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FlyoutValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="FlyoutHeaderIconButton" TargetType="Button">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderIconChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="{DynamicResource GhostBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0"
            ClipToBounds="True">
        <DockPanel>
            <Grid x:Name="FlyoutHeaderGrid"
                  DockPanel.Dock="Top"
                  Margin="16,16,16,8"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           Text="CodexMeter"
                           FontWeight="SemiBold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <Grid Grid.Column="1" Margin="0,0,8,0" MinWidth="0">
                    <TextBlock x:Name="StatusText"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"/>
                    <TextBlock x:Name="RefreshProgressText"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="11"
                               Visibility="Collapsed"/>
                </Grid>
                <Button x:Name="RefreshAllButton"
                        Grid.Column="2"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnRefreshAllClick"
                        ToolTip="Refresh all"
                        AutomationProperties.Name="Refresh all"
                        Margin="0,0,4,0">
                    <Grid Width="16" Height="16">
                        <TextBlock x:Name="RefreshAllIcon"
                                   Text="↻"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Viewbox x:Name="RefreshSpinner"
                                 Width="16"
                                 Height="16"
                                 Stretch="Uniform"
                                 Visibility="Collapsed"
                                 RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="RefreshSpinnerRotate" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Path Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Stretch="None"
                                  Width="16"
                                  Height="16">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="14,8" IsClosed="False">
                                            <ArcSegment Point="8,2"
                                                        Size="6,6"
                                                        SweepDirection="Clockwise"
                                                        IsLargeArc="True"
                                                        IsStroked="True"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                        </Viewbox>
                    </Grid>
                </Button>
                <Button x:Name="SettingsButton" Grid.Column="3"
                        Style="{StaticResource FlyoutHeaderIconButton}" Click="OnSettingsClick" Margin="0,0,4,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource TextBrush}"/>
                </Button>
                <Button x:Name="PinButton"
                        Grid.Column="4"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnPinClick"
                        ToolTip="Pin"
                        AutomationProperties.Name="Pin"
                        Margin="0,0,4,0">
                    <Grid Width="14" Height="14">
                        <Path x:Name="PinOutline"
                              Stroke="{DynamicResource TextBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stretch="Uniform"
                              Data="M7,1 C5.3,1 4,2.5 4,4.2 L4,7.2 L2.2,7.2 L2.2,8.8 L6.2,8.8 L6.2,13 L7.8,13 L7.8,8.8 L11.8,8.8 L11.8,7.2 L10,7.2 L10,4.2 C10,2.5 8.7,1 7,1 Z"/>
                        <Path x:Name="PinFilled"
                              Fill="{DynamicResource AccentBrush}"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="0.4"
                              Stretch="Uniform"
                              Visibility="Collapsed"
                              Data="M7,1 C5.3,1 4,2.5 4,4.2 L4,7.2 L2.2,7.2 L2.2,8.8 L6.2,8.8 L6.2,13 L7.8,13 L7.8,8.8 L11.8,8.8 L11.8,7.2 L10,7.2 L10,4.2 C10,2.5 8.7,1 7,1 Z"/>
                    </Grid>
                </Button>
                <Button x:Name="CloseFlyoutButton"
                        Grid.Column="5"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnCloseClick"
                        ToolTip="Close"
                        AutomationProperties.Name="Close">
                    <Path Width="12"
                          Height="12"
                          Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          Data="M2,2 L10,10 M10,2 L2,10"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
            <StackPanel Margin="16,8,16,16">

            <!-- CODEX -->
            <Border x:Name="CodexCard" Style="{StaticResource FlyoutCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CodexSectionTitle" Grid.Column="0" Style="{StaticResource FlyoutCardTitle}" Text="CODEX"/>
                    </Grid>

                    <TextBlock x:Name="CodexStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <Grid x:Name="CodexBodyGrid" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="CodexRingHost" Grid.Column="0" Width="92" Height="92" VerticalAlignment="Top">
                            <Ellipse x:Name="CodexRingTrack" Width="92" Height="92" StrokeThickness="9" Stroke="{DynamicResource LineBrush}"/>
                            <Path x:Name="CodexRingArcPath" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource AccentBrush}" Fill="Transparent" Visibility="Collapsed">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure x:Name="CodexRingFigure" IsClosed="False">
                                            <ArcSegment x:Name="CodexRingArcSegment" SweepDirection="Clockwise"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Ellipse x:Name="CodexRingFullCircle" Width="92" Height="92" StrokeThickness="9"
                                     Stroke="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="CodexRingValueText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="CodexRingSubLabel" FontSize="9" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="74" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="CodexRows" Grid.Column="1" Margin="14,0,0,0"/>
                    </Grid>

                    <StackPanel x:Name="CodexLegendPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="CodexLegendUsedText" FontSize="11" VerticalAlignment="Center" Margin="4,0,14,0" Foreground="{DynamicResource MutedBrush}"/>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource LineBrush}"/>
                        <TextBlock x:Name="CodexLegendRemainingText" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </DockPanel>
    </Border>
</Window>

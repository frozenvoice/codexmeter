<Window x:Class="ProMeter.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProMeter"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FlyoutValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
        <StackPanel>
            <Grid x:Name="FlyoutHeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           Text="ProMeter"
                           FontWeight="SemiBold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <Grid Grid.Column="1" Margin="0,0,8,0" MinWidth="0">
                    <TextBlock x:Name="StatusText"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"/>
                    <TextBlock x:Name="RefreshProgressText"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="11"
                               Visibility="Collapsed"/>
                </Grid>
                <Button x:Name="RefreshAllButton"
                        Grid.Column="2"
                        Click="OnRefreshAllClick"
                        PreviewMouseDown="OnRefreshPreviewMouseDown"
                        ToolTip="Refresh all"
                        AutomationProperties.Name="Refresh all"
                        MinWidth="28"
                        MinHeight="28"
                        Padding="6,2"
                        Cursor="Hand"
                        Background="{DynamicResource GhostBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        BorderThickness="0"
                        Focusable="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RefreshChrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RefreshChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="RefreshChrome" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                                    <Setter TargetName="RefreshChrome" Property="Background" Value="{DynamicResource GhostBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Width="16" Height="16">
                        <TextBlock x:Name="RefreshAllIcon"
                                   Text="↻"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Viewbox x:Name="RefreshSpinner"
                                 Width="16"
                                 Height="16"
                                 Stretch="Uniform"
                                 Visibility="Collapsed"
                                 RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="RefreshSpinnerRotate" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Path Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Stretch="None"
                                  Width="16"
                                  Height="16">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="14,8" IsClosed="False">
                                            <ArcSegment Point="8,2"
                                                        Size="6,6"
                                                        SweepDirection="Clockwise"
                                                        IsLargeArc="True"
                                                        IsStroked="True"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                        </Viewbox>
                    </Grid>
                </Button>
            </Grid>

            <TextBlock Style="{StaticResource SectionTitle}" Text="GPT PRO"/>
            <DockPanel>
                <TextBlock x:Name="ProStateLabel" Text="Status" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="ProStateText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock x:Name="ServerResetLabel" Text="Server reset" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="ServerResetText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock x:Name="ExactRemainingLabel" Text="Exact remaining" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="ExactRemainingText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
            </DockPanel>
            <TextBlock x:Name="RestrictionDetailText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="HistoryStatsLabel" Style="{StaticResource SectionTitle}" Text="HISTORY"/>
            <DockPanel>
                <TextBlock x:Name="ConfirmedRequestsLabel" Text="Confirmed Pro requests" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="ConfirmedRequestsText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
            </DockPanel>
            <TextBlock x:Name="CountSourceText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
            <DockPanel x:Name="AuthoritativeCountPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock x:Name="ProCountText" DockPanel.Dock="Right" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                <Border Height="8" CornerRadius="4" Background="{DynamicResource LineBrush}" Margin="0,4,12,0">
                    <Border x:Name="ProBar" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource AccentBrush}"/>
                </Border>
            </DockPanel>
            <StackPanel x:Name="Pro200Panel" Visibility="Collapsed" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock x:Name="Gpt6WeekLabel" Text="GPT-6 Pro week" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="Gpt6WeekText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock x:Name="SolDailyLabel" Text="Sol Pro daily" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="SolDailyText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock x:Name="CombinedDailyLabel" Text="Combined daily" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="CombinedDailyText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
                </DockPanel>
            </StackPanel>
            <ItemsControl x:Name="ModelRows" Margin="0,8,0,0"/>

            <TextBlock x:Name="CodexSectionTitle" Style="{StaticResource SectionTitle}" Text="CODEX"/>
            <TextBlock x:Name="CodexStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            <ItemsControl x:Name="CodexRows" Margin="0,4,0,0"/>

            <TextBlock x:Name="ReasoningSectionTitle" Style="{StaticResource SectionTitle}" Text="SOL REASONING"/>
            <DockPanel><TextBlock x:Name="ReasonTodayLabel" Text="Today" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ReasonToday" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock x:Name="ReasonWeekLabel" Text="This week" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ReasonWeek" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock x:Name="ReasonMediumLabel" Text="Medium" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ReasonMedium" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock x:Name="ReasonHighLabel" Text="High" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ReasonHigh" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock x:Name="ReasonExtraLabel" Text="Extra High" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ReasonExtra" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel x:Name="ReasonLimitPanel" Margin="0,4,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ReasonLimitLabel" Text="Limit" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="ReasonLimit" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
            </DockPanel>
            <TextBlock x:Name="ReasoningNoteText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <TextBlock x:Name="StatusSectionTitle" Style="{StaticResource SectionTitle}" Text="STATUS"/>
            <DockPanel><TextBlock x:Name="ResetTimeLabel" Text="Reset time" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ResetText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <DockPanel x:Name="ResetEstimatePanel" Margin="0,4,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ResetEstimateLabel" Text="Estimate" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="ResetEstimateText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0"><TextBlock x:Name="LastSyncLabel" Text="Last sync" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="SyncText" Style="{StaticResource FlyoutValueText}" DockPanel.Dock="Right"/></DockPanel>
            <Button Click="OnCoverageClick" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand" Margin="0,4,0,0">
                <DockPanel>
                    <TextBlock x:Name="CoverageLabel" Text="Coverage" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="CoverageText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/>
                </DockPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="ProMeter.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexMeter" Width="480" Height="650" MinWidth="420" MinHeight="480"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="LogsButton" Style="{StaticResource GhostButton}" Click="OnOpenLogs" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="CodexTitle" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="CodexHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                <TextBlock x:Name="CodexExeLabel" Margin="0,0,0,6"/>
                <TextBox x:Name="CodexExeBox"/>
                <TextBlock x:Name="AppearanceTitle" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="ThemeLabel" Margin="0,0,0,6"/>
                <ComboBox x:Name="ThemeBox" Margin="0,0,0,12"/>
                <TextBlock x:Name="LanguageLabel" Margin="0,0,0,6"/>
                <ComboBox x:Name="LanguageBox" Margin="0,0,0,12"/>
                <TextBlock x:Name="IconLabel" Margin="0,0,0,6"/>
                <ComboBox x:Name="IconBox" Margin="0,0,0,12"/>
                <CheckBox x:Name="StartupBox" Margin="0,4"/>
                <CheckBox x:Name="TaskbarStatusBox" Margin="0,4"/>
                <CheckBox x:Name="WidgetBox" Margin="0,4"/>
                <StackPanel IsEnabled="{Binding IsChecked, ElementName=WidgetBox}">
                <TextBlock x:Name="WidgetOpacityLabel" Margin="0,8,0,4"/>
                <Slider x:Name="WidgetOpacityBox" Minimum="0.25" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                <CheckBox x:Name="WidgetTopBox" Margin="0,4"/>
                <CheckBox x:Name="WidgetClickThroughBox" Margin="0,4"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

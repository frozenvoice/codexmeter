<Window x:Class="ProMeter.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProMeter Settings"
        Width="520"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>

            <TextBlock Style="{StaticResource SectionTitle}" Text="PLAN"/>
            <ComboBox x:Name="PlanBox" SelectionChanged="OnPlanChanged">
                <ComboBoxItem Content="Pro $100"/>
                <ComboBoxItem Content="Pro $200"/>
                <ComboBoxItem Content="Custom"/>
            </ComboBox>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="Weekly Pro quota" VerticalAlignment="Center"/>
                <TextBox x:Name="WeeklyBox" Grid.Column="1" Margin="0,4"/>
                <TextBlock Text="Daily Pro quota" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox x:Name="DailyBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                <TextBlock Text="Sol Pro daily quota" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBox x:Name="SolDailyBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                <TextBlock Text="Combined daily quota" Grid.Row="3" VerticalAlignment="Center"/>
                <TextBox x:Name="CombinedBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                <TextBlock Text="Reasoning quota" Grid.Row="4" VerticalAlignment="Center"/>
                <TextBox x:Name="ReasoningBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
            </Grid>

            <TextBlock Style="{StaticResource SectionTitle}" Text="RESET ANCHOR"/>
            <TextBlock Text="Weekday and time are estimates unless you confirm them below. Saving other settings does not confirm this anchor."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DockPanel>
                <ComboBox x:Name="WeekdayBox" Width="140">
                    <ComboBoxItem Content="Sunday"/><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Tuesday"/>
                    <ComboBoxItem Content="Wednesday"/><ComboBoxItem Content="Thursday"/><ComboBoxItem Content="Friday"/>
                    <ComboBoxItem Content="Saturday"/>
                </ComboBox>
                <TextBox x:Name="ResetTimeBox" Width="80" Margin="8,0,0,0" Text="00:00"/>
            </DockPanel>
            <CheckBox x:Name="ResetAnchorBox"
                      Content="Use this reset anchor when the server reset time is unavailable"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,8,0,0"/>

            <TextBlock Style="{StaticResource SectionTitle}" Text="APP"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="ProMeter uses unofficial ChatGPT web endpoints. They are not part of the public OpenAI API and may change. Programmatic history access is unsupported and may carry account or terms risk. Review current ChatGPT terms before enabling synchronization. Official ChatGPT Data Export import is the lower-risk fallback but is not real-time."/>
            <CheckBox x:Name="AutoSyncBox" Content="Automatic history synchronization" Foreground="{StaticResource TextBrush}" Margin="0,4"/>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Sync interval (minutes)" VerticalAlignment="Center"/>
                <TextBox x:Name="IntervalBox" Width="80" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
            <CheckBox x:Name="StartupBox" Content="Start with Windows" Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>
            <CheckBox x:Name="WidgetBox" Content="Floating widget" Foreground="{StaticResource TextBrush}" Margin="0,4"/>
            <ComboBox x:Name="ThemeBox" Margin="0,8,0,0">
                <ComboBoxItem Content="System"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>
            <ComboBox x:Name="IconBox" Margin="0,8,0,0">
                <ComboBoxItem Content="Remaining number"/>
                <ComboBoxItem Content="Progress ring"/>
            </ComboBox>
            <CheckBox x:Name="FlyoutCloseBox" Content="Close flyout when it loses focus" Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>

            <TextBlock Style="{StaticResource SectionTitle}" Text="NOTIFICATIONS"/>
            <CheckBox x:Name="N20" Content="20% remaining" Foreground="{StaticResource TextBrush}" Margin="0,4"/>
            <CheckBox x:Name="N10" Content="10% remaining" Foreground="{StaticResource TextBrush}" Margin="0,4"/>
            <CheckBox x:Name="NEx" Content="Quota exhausted" Foreground="{StaticResource TextBrush}" Margin="0,4"/>
            <CheckBox x:Name="NReset" Content="Quota reset" Foreground="{StaticResource TextBrush}" Margin="0,4"/>
            <CheckBox x:Name="NErr" Content="Sync / authentication error" Foreground="{StaticResource TextBrush}" Margin="0,4"/>

            <TextBlock Style="{StaticResource SectionTitle}" Text="DATA"/>
            <WrapPanel Margin="0,4,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Import conversations.json" Click="OnImport" Margin="0,0,8,8"/>
                <Button Style="{StaticResource GhostButton}" Content="Export JSON" Click="OnExportJson" Margin="0,0,8,8"/>
                <Button Style="{StaticResource GhostButton}" Content="Export CSV" Click="OnExportCsv" Margin="0,0,8,8"/>
                <Button Style="{StaticResource GhostButton}" Content="Open logs" Click="OnOpenLogs" Margin="0,0,8,8"/>
            </WrapPanel>
            <CheckBox x:Name="HistoricalBox" Content="Import older than the current quota period" Foreground="{StaticResource TextBrush}" Margin="0,4"/>

            <Button Style="{StaticResource PrimaryButton}" Content="Save" HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnSave"/>
        </StackPanel>
    </ScrollViewer>
</Window>

<Window x:Class="ProMeter.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProMeter Settings"
        Width="520"
        Height="840"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Settings" FontSize="20" FontWeight="SemiBold"/>

            <TextBlock x:Name="PlanTitle" Style="{StaticResource SectionTitle}" Text="PLAN"/>
            <ComboBox x:Name="PlanBox" SelectionChanged="OnPlanChanged">
                <ComboBoxItem Content="Pro $100"/>
                <ComboBoxItem Content="Pro $200"/>
                <ComboBoxItem Content="Custom"/>
            </ComboBox>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="WeeklyLabel" Text="Weekly Pro quota" VerticalAlignment="Center"/>
                <TextBox x:Name="WeeklyBox" Grid.Column="1" Margin="0,4"/>
                <TextBlock x:Name="DailyLabel" Text="Daily Pro quota" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox x:Name="DailyBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                <TextBlock x:Name="SolDailyLabel" Text="Sol Pro daily quota" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBox x:Name="SolDailyBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                <TextBlock x:Name="CombinedLabel" Text="Combined daily quota" Grid.Row="3" VerticalAlignment="Center"/>
                <TextBox x:Name="CombinedBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                <TextBlock x:Name="ReasoningLabel" Text="Reasoning quota" Grid.Row="4" VerticalAlignment="Center"/>
                <TextBox x:Name="ReasoningBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
            </Grid>

            <TextBlock x:Name="ResetTitle" Style="{StaticResource SectionTitle}" Text="RECONSTRUCTION WINDOW"/>
            <TextBlock x:Name="ResetHint" Text="Used only for history statistics when a server reset time is unavailable. This is not the actual Pro quota reset."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DockPanel>
                <ComboBox x:Name="WeekdayBox" Width="140">
                    <ComboBoxItem Content="Sunday"/><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Tuesday"/>
                    <ComboBoxItem Content="Wednesday"/><ComboBoxItem Content="Thursday"/><ComboBoxItem Content="Friday"/>
                    <ComboBoxItem Content="Saturday"/>
                </ComboBox>
                <TextBox x:Name="ResetTimeBox" Width="80" Margin="8,0,0,0" Text="00:00"/>
            </DockPanel>
            <CheckBox x:Name="ResetAnchorBox"
                      Content="Use this reset anchor when the server reset time is unavailable"
                      Foreground="{DynamicResource TextBrush}"
                      Margin="0,8,0,0"/>

            <TextBlock x:Name="ConnectionTitle" Style="{StaticResource SectionTitle}" Text="CONNECTION"/>
            <TextBlock x:Name="ConnectionHint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Browser companion uses your normal Chrome or Edge ChatGPT session and avoids embedded social OAuth. It does not make unofficial ChatGPT endpoints official. WebView2 is a fallback only when that sign-in method works. Google/Microsoft/Apple login inside WebView2 is unsupported. Data Export remains the lower-risk non-real-time fallback."/>
            <ComboBox x:Name="TransportBox" Margin="0,0,0,8">
                <ComboBoxItem Content="Browser companion"/>
                <ComboBoxItem Content="WebView2 fallback"/>
                <ComboBoxItem Content="Data Export only"/>
            </ComboBox>
            <TextBlock x:Name="ChromeIdLabel" Foreground="{DynamicResource MutedBrush}" Text="Chrome unpacked extension ID (32 letters a-p)" Margin="0,0,0,4"/>
            <TextBox x:Name="ChromeExtensionIdBox" Margin="0,0,0,8"/>
            <TextBlock x:Name="EdgeIdLabel" Foreground="{DynamicResource MutedBrush}" Text="Edge unpacked extension ID if different" Margin="0,0,0,4"/>
            <TextBox x:Name="EdgeExtensionIdBox" Margin="0,0,0,8"/>
            <TextBlock x:Name="PairingHint" Foreground="{DynamicResource MutedBrush}" Text="Local pairing token (not a ChatGPT secret). The native host attaches it automatically." Margin="0,0,0,4"/>
            <TextBox x:Name="PairingBox" Margin="0,0,0,8" IsReadOnly="True"/>
            <Button x:Name="RegisterButton" Style="{StaticResource GhostButton}" Content="Register Chrome/Edge native host" Click="OnRegisterCompanion" HorizontalAlignment="Left" Margin="0,0,0,8"/>

            <TextBlock x:Name="AppTitle" Style="{StaticResource SectionTitle}" Text="APP"/>
            <TextBlock x:Name="AppHint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="ProMeter uses unofficial ChatGPT web endpoints. They are not part of the public OpenAI API and may change. Programmatic history access is unsupported and may carry account or terms risk. Review current ChatGPT terms before enabling synchronization. Official ChatGPT Data Export import is the lower-risk fallback but is not real-time."/>
            <CheckBox x:Name="AutoSyncBox" Content="Automatic history synchronization" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>
            <DockPanel Margin="0,4,0,0">
                <TextBlock x:Name="IntervalLabel" Text="Sync interval (minutes)" VerticalAlignment="Center"/>
                <TextBox x:Name="IntervalBox" Width="80" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
            <CheckBox x:Name="StartupBox" Content="Start with Windows" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,4"/>
            <CheckBox x:Name="WidgetBox" Content="Floating widget" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>
            <TextBlock x:Name="WidgetHint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="18,0,0,4"/>
            <DockPanel x:Name="WidgetOptionsPanel" Margin="18,0,0,4">
                <TextBlock x:Name="WidgetOpacityLabel" Text="Opacity" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <TextBox x:Name="WidgetOpacityBox" Width="64" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8,0,0,0"/>
            </DockPanel>
            <CheckBox x:Name="WidgetTopBox" Content="Always on top" Foreground="{DynamicResource TextBrush}" Margin="18,2,0,0"/>
            <CheckBox x:Name="WidgetClickThroughBox" Content="Click through" Foreground="{DynamicResource TextBrush}" Margin="18,2,0,0"/>
            <TextBlock x:Name="WidgetClickThroughHint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="18,0,0,4"/>
            <CheckBox x:Name="TaskbarStatusBox" Content="Always show taskbar status" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>
            <TextBlock x:Name="TaskbarStatusHint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="18,0,0,4"/>
            <TextBlock x:Name="CodexExeLabel" Text="Codex executable path (optional)" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
            <TextBox x:Name="CodexExeBox" Margin="0,0,0,4"/>
            <TextBlock x:Name="CodexExeHint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
            <TextBlock x:Name="LanguageLabel" Text="Language / 언어" Margin="0,8,0,4" Foreground="{DynamicResource MutedBrush}"/>
            <ComboBox x:Name="LanguageBox" Margin="0,0,0,0">
                <ComboBoxItem Content="한국어"/>
                <ComboBoxItem Content="English"/>
            </ComboBox>
            <ComboBox x:Name="ThemeBox" Margin="0,8,0,0">
                <ComboBoxItem Content="System"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>
            <ComboBox x:Name="IconBox" Margin="0,8,0,0">
                <ComboBoxItem Content="Remaining number"/>
                <ComboBoxItem Content="Progress ring"/>
            </ComboBox>
            <CheckBox x:Name="FlyoutCloseBox" Content="Close flyout when it loses focus" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,4"/>

            <TextBlock x:Name="NotificationsTitle" Style="{StaticResource SectionTitle}" Text="NOTIFICATIONS"/>
            <CheckBox x:Name="N20" Content="20% remaining" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>
            <CheckBox x:Name="N10" Content="10% remaining" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>
            <CheckBox x:Name="NEx" Content="Quota exhausted" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>
            <CheckBox x:Name="NReset" Content="Quota reset" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>
            <CheckBox x:Name="NErr" Content="Sync / authentication error" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>

            <TextBlock x:Name="DataTitle" Style="{StaticResource SectionTitle}" Text="DATA"/>
            <WrapPanel Margin="0,4,0,0">
                <Button x:Name="ImportButton" Style="{StaticResource GhostButton}" Content="Import conversations.json" Click="OnImport" Margin="0,0,8,8"/>
                <Button x:Name="ExportJsonButton" Style="{StaticResource GhostButton}" Content="Export JSON" Click="OnExportJson" Margin="0,0,8,8"/>
                <Button x:Name="ExportCsvButton" Style="{StaticResource GhostButton}" Content="Export CSV" Click="OnExportCsv" Margin="0,0,8,8"/>
                <Button x:Name="OpenLogsButton" Style="{StaticResource GhostButton}" Content="Open logs" Click="OnOpenLogs" Margin="0,0,8,8"/>
            </WrapPanel>
            <CheckBox x:Name="HistoricalBox" Content="Import older than the current quota period" Foreground="{DynamicResource TextBrush}" Margin="0,4"/>

            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save" HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnSave"/>
        </StackPanel>
    </ScrollViewer>
</Window>

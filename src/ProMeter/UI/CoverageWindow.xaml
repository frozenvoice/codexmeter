<Window x:Class="ProMeter.UI.CoverageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data status"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="Headline" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="DisclaimerText"
                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <TextBlock x:Name="NormalText"/>
        <TextBlock x:Name="ArchivedText" Margin="0,4,0,0"/>
        <TextBlock x:Name="ProjectsText" Margin="0,4,0,0"/>
        <TextBlock x:Name="BodiesText" Margin="0,4,0,0"/>
        <TextBlock x:Name="TemporaryText" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
        <TextBlock x:Name="DeletedText" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
        <TextBlock x:Name="CountBasisText" Margin="0,4,0,0"/>
        <TextBlock x:Name="CountConfidenceText" Margin="0,4,0,0"/>
        <TextBlock x:Name="ResetBasisText" Margin="0,4,0,0"/>
        <TextBlock x:Name="BranchesText" Margin="0,4,0,0"/>
        <TextBlock x:Name="NotesText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
        <StackPanel x:Name="FailurePanel" Margin="0,12,0,0"/>
        <TextBlock x:Name="CodexTitle" Style="{StaticResource SectionTitle}" Text="CODEX"/>
        <TextBlock x:Name="CodexText" TextWrapping="Wrap" Margin="0,0,0,0"/>
        <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Content="Close" Margin="0,16,0,0" HorizontalAlignment="Right" Click="OnClose"/>
    </StackPanel>
</Window>

<Window x:Class="CodexMeter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexMeter"
        Width="760"
        Height="620"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="CodexMeter" FontSize="22" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SyncButton" Style="{StaticResource GhostButton}" Content="Sync now" Click="OnSync" Margin="0,0,8,0"/>
                <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}" Content="Settings" Click="OnSettings"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="Headline" DockPanel.Dock="Top" FontSize="16" Margin="0,0,0,12"/>
        <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
            <TabItem x:Name="OverviewTab" Header="Overview">
                <ScrollViewer>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock x:Name="ProStatusText" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="PeriodText" Foreground="{DynamicResource MutedBrush}"/>
                        <ItemsControl x:Name="ModelList" Margin="0,12,0,0"/>
                        <TextBlock x:Name="CodexSectionTitle" Style="{StaticResource SectionTitle}" Text="CODEX"/>
                        <TextBlock x:Name="CodexText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReasoningSectionTitle" Style="{StaticResource SectionTitle}" Text="SOL REASONING"/>
                        <TextBlock x:Name="ReasonText"/>
                        <TextBlock x:Name="StatusSectionTitle" Style="{StaticResource SectionTitle}" Text="STATUS"/>
                        <TextBlock x:Name="StatusText"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TrendsTab" Header="Trends">
                <Grid Margin="0,12,0,0">
                    <Canvas x:Name="ChartCanvas" Height="280" Background="{DynamicResource ControlBrush}"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="BreakdownTab" Header="Breakdown">
                <DataGrid x:Name="EventGrid" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="TimeColumn" Header="Time" Binding="{Binding CreatedAt}" Width="160"/>
                        <DataGridTextColumn x:Name="ModelColumn" Header="Model" Binding="{Binding NormalizedModel}" Width="160"/>
                        <DataGridTextColumn x:Name="RawColumn" Header="Raw" Binding="{Binding RawModel}" Width="140"/>
                        <DataGridTextColumn x:Name="EffortColumn" Header="Effort" Binding="{Binding ReasoningEffort}" Width="100"/>
                        <DataGridTextColumn x:Name="FamilyColumn" Header="Family" Binding="{Binding QuotaFamily}" Width="110"/>
                        <DataGridTextColumn x:Name="SourceColumn" Header="Source" Binding="{Binding Source}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

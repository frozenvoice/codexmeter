<Window x:Class="CodexMeter.UI.CoverageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data status"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="Headline" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="ChatGptServerText" Margin="0,12,0,0"/>
        <TextBlock x:Name="CodexStatusRowText" Margin="0,4,0,0"/>
        <TextBlock x:Name="HistoryStatsText" Margin="0,4,0,0"/>
        <TextBlock x:Name="DisclaimerText"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
        <Expander x:Name="AdvancedExpander"
                  Margin="0,16,0,0"
                  IsExpanded="False">
            <Expander.Header>
                <TextBlock x:Name="AdvancedHeader" Foreground="{DynamicResource TextBrush}"/>
            </Expander.Header>
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <StackPanel x:Name="AdvancedPanel"/>
            </ScrollViewer>
        </Expander>
        <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Content="Close" Margin="0,16,0,0" HorizontalAlignment="Right" Click="OnClose"/>
    </StackPanel>
</Window>

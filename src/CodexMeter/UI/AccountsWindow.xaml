<Window x:Class="CodexMeter.UI.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Width="660" Height="680" MinWidth="470" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnPreviewKeyDown"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" MouseLeftButtonDown="OnHeadingDrag"/>
            <TextBlock x:Name="Introduction" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="LabelCaption" Margin="0,0,0,6"/>
                <TextBox x:Name="NewAccountLabel" MaxLength="80" Padding="8,6"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="AddAccountButton" Style="{StaticResource CreditUseButton}" Click="OnAdd" Margin="0,0,8,6"/>
                    <Button x:Name="DiscoverButton" Style="{StaticResource CreditUseButton}" Click="OnDiscover" Margin="0,0,8,6"/>
                    <Button x:Name="ChooseHomeButton" Style="{StaticResource CreditUseButton}" Click="OnChooseHome" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <ProgressBar x:Name="OperationProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource GhostBrush}"/>
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="CancelOperationButton" DockPanel.Dock="Right" Style="{StaticResource CreditUseButton}"
                        Click="OnCancelOperation" Visibility="Collapsed" Margin="10,0,0,0"/>
                <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <ScrollViewer x:Name="AccountsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="AccountRows" Margin="0,0,6,0"/>
        </ScrollViewer>
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource CreditUseButton}" Click="OnDone" Margin="12,0,0,0"/>
            <TextBlock x:Name="PrivacyHint" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        </DockPanel>
    </Grid>
    </Border>
</Window>

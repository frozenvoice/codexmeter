<Window x:Class="CodexMeter.UI.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexMeter widget" Style="{StaticResource AppWindow}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        PreviewMouseLeftButtonDown="OnPreviewLeftDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewLeftUp"
        LostMouseCapture="OnLostMouseCapture" MouseDown="OnMouseDown">
    <Border Background="{DynamicResource CardBrush}"
            CornerRadius="10"
            Padding="10,8"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            MinWidth="168">
        <!-- The native window can be taller than DesiredSize; center within its actual height. -->
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="AccountName" Visibility="Collapsed" MaxWidth="230" TextTrimming="CharacterEllipsis"
                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}"/>
            <DockPanel>
                <TextBlock x:Name="CodexValue"
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12"/>
                <TextBlock x:Name="CodexLabel"
                           Text="Codex"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12"/>
            </DockPanel>
            <TextBlock x:Name="HistoryValue"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
